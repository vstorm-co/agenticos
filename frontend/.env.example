# Frontend configuration. Copy to .env.local for local development.
#
# Two kinds, and the difference is load-bearing:
#
#   server-side      read at runtime. Change one and restart.
#   NEXT_PUBLIC_*    inlined into the browser bundle at BUILD time.
#                    Change one and rebuild — restarting does nothing.
#
# `BACKEND_WS_URL` and `NEXT_PUBLIC_AUTH_ENABLED` used to be listed here and are
# gone: nothing in the app read either. The chat socket comes from
# NEXT_PUBLIC_WS_URL, and the auth UI is not behind a flag.

# --- Server-side ---

# Where the route handlers proxy to. Same-origin proxying is what keeps the auth
# cookies working, so this stays server-side and never reaches the browser.
BACKEND_URL=http://localhost:8000

# --- Browser (build-time) ---

# What the browser calls. In a deployed environment this is the public hostname,
# never a container name.
NEXT_PUBLIC_API_URL=http://localhost:8000

# The chat WebSocket. The browser opens this against the backend directly rather
# than through the Next proxy.
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# This app's own public URL — OAuth redirects and page metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Client-side upload limit. Keep it at or below the backend's, or the browser
# accepts a file the API then refuses.
NEXT_PUBLIC_CHAT_MAX_UPLOAD_SIZE_MB=10

# Comma-separated. `google` is the provider that is wired up.
NEXT_PUBLIC_OAUTH_PROVIDERS=google

# Show the knowledge-base UI.
NEXT_PUBLIC_RAG_ENABLED=true

# --- Optional: server-side tracing ---
# Get a write token from https://logfire.pydantic.dev
# OTEL_EXPORTER_OTLP_ENDPOINT=https://logfire-api.pydantic.dev
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=your-logfire-write-token
