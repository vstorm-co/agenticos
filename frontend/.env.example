# Frontend configuration. Copy to .env.local for local development.
#
# Everything here is read on the server at runtime - change one and restart.
# Nothing is inlined into the browser bundle at build time, so one built image
# serves every deployment; what the browser needs to know it is told per request
# (see src/lib/public-config.ts).

# --- Server-side only ---

# Where the route handlers proxy to. Same-origin proxying is what keeps the auth
# cookies working, so this stays server-side and never reaches the browser.
BACKEND_URL=http://localhost:8000

# --- Handed to the browser ---

# What the browser calls directly: OAuth login, hosted-page uploads, the API docs
# link. In a deployed environment this is the public hostname, never a container
# name.
PUBLIC_API_URL=http://localhost:8000

# The chat WebSocket. The browser opens this against the backend directly rather
# than through the Next proxy.
PUBLIC_WS_URL=ws://localhost:8000

# This app's own public URL - page metadata, robots.txt and the sitemap.
PUBLIC_SITE_URL=http://localhost:3000

# The composer's ceiling. The same variable the backend reads, so a compose file
# passes one value to both containers; a mismatch means the browser accepts a file
# the API refuses, or refuses one it would take.
CHAT_MAX_UPLOAD_SIZE_MB=10

# Comma-separated: google, github, microsoft. Empty turns the buttons off.
OAUTH_PROVIDERS=google

# --- Optional: server-side tracing ---
# Get a write token from https://logfire.pydantic.dev
# OTEL_EXPORTER_OTLP_ENDPOINT=https://logfire-api.pydantic.dev
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=your-logfire-write-token
