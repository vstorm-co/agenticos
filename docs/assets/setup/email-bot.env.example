# Deployment-level outbound mail, not an IMAP polling account.
# Replace locally; do not commit or share a populated copy.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=agent@example.com
SMTP_PASSWORD=REPLACE_LOCALLY
SMTP_TLS=true
SMTP_TLS_MODE=starttls
PUBLIC_BASE_URL=https://agents.example.com
