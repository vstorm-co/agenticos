# agenticos Environment Variables
#
# Only deployment-level configuration lives here: credentials the operator is
# billed for, addresses on this machine's network, and limits that describe the
# host. Everything about the *product* — models, agents, parsers, budgets,
# channel bots — is configured inside the application (vault, Builder, /kb).

# === Project ===
PROJECT_NAME=agenticos
DEBUG=true
DB_ECHO=false  # Set to true to log SQL queries
ENVIRONMENT=local
TIMEZONE=UTC  # IANA timezone: UTC, Europe/Warsaw, America/New_York
MODELS_CACHE_DIR=./models_cache

# === A worker whose event loop has stopped turning ===
# Seconds the event loop may go without turning before the worker is killed and
# replaced. Read twice, and it applies to all three stacks: by the worker itself
# (`app/core/watchdog.py`), which is what covers the dev and production stacks,
# and by `cli/reload_supervisor.py`, which is PID 1 of the local `app` container
# and of `make run` and judges the same loop from outside.
#
# Set it to 0 (or below) while debugging: a breakpoint blocks the event loop,
# which is exactly what the check looks for. One number, so that switches off
# both judges rather than leaving one to kill the session.
# EVENT_LOOP_WEDGED_AFTER=15

# === Logfire ===
# Get your token at https://logfire.pydantic.dev
LOGFIRE_TOKEN=
LOGFIRE_SERVICE_NAME=agenticos
LOGFIRE_ENVIRONMENT=development

# === PostgreSQL ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agenticos

# === JWT Auth ===
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# === Public addresses ===
# Where this deployment is reachable. Everything outward-facing — embed
# scripts, OAuth callbacks, Telegram webhooks — is built from these.
FRONTEND_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8000

# The same three addresses again, for the *browser* rather than for the server.
# Read by `docker-compose-prod.frontend.yml` as **build arguments**: Next inlines
# them into the bundle, so changing one is a rebuild rather than a restart, and a
# deployed frontend refuses to build without them. They are separate from the two
# above because the two above are read by the application at run time - the same
# values, at a different moment, which is the whole reason both exist.
PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
PUBLIC_WS_URL=ws://localhost:8000

# === Secret vault ===
# Master key for every credential stored at rest — provider keys, channel bot
# tokens, MCP credentials and organization secrets. Empty falls back to
# SECRET_KEY so a fresh checkout runs, and is refused outside
# local/development. Generate with: openssl rand -hex 32
VAULT_MASTER_KEY=
# The staged form for rotation: every version still in use, as JSON — the
# highest seals new secrets, older ones keep existing rows readable until
# `agenticos cmd vault-rotate` re-wraps them. When set, VAULT_MASTER_KEY must
# stay empty. See docs/secrets.md#operations.
# VAULT_MASTER_KEYS={"1": "<old>", "2": "<new>"}

# === API Key Auth ===
API_KEY=change-me-in-production
API_KEY_HEADER=X-API-Key

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_DB=0

# === Embeddings ===
# No credential here. Every collection names the organization vault key that
# pays for its embeddings and the provider it embeds through, the same way chat
# models are keyed per organization.
# Deployment-level on purpose: pgvector columns are created at this model's
# width, so changing it mid-life invalidates every existing collection.
EMBEDDING_MODEL=text-embedding-3-large

# === RAG parser credentials and addresses ===
# How documents are parsed, chunked and described is NOT configured here — it is
# a per-collection setting stored on the knowledge base and edited on /kb. A
# collection can also name its own vault key for LlamaParse; this one is the
# fallback for collections that chose none. The OCR address stays deployment
# infrastructure — an address on the internal network is not something a
# tenant may choose.
LLAMAPARSE_API_KEY=
# LiteParse OCR — empty uses the bundled Tesseract; point at e.g.
# http://easyocr:8000 or http://paddleocr:8000 for HTTP OCR.
LITEPARSE_OCR_SERVER_URL=

# --- Agent workspaces -------------------------------------------------------
# The `state` workspace needs nothing here: it is stored in this database and
# works on every deployment.
#
# A container-backed one needs no setting either. *Where* sandboxes run is a row
# per organization - Settings -> Sandboxes in the app - because a deployment can
# hold more than one host and the token belongs in the vault with every other
# credential.
#
# SANDBOXD_TOKEN below is the *service's* own, not the app's: it is what the
# daemon in the compose file will accept. `make sandbox-token` generates one, and
# the connection form offers to store this same value in the vault for you - the
# API reads this setting for that one purpose and never to reach a host, so a
# deployment that leaves it empty loses one button and pastes the token instead.
# It authorises opening a session, and a session runs commands on the host holding
# the Docker socket - so treat it like the socket itself: never in a browser,
# never in a log, never committed.
# Left unset: `make dev` generates one and appends it. An empty assignment
# here would sit above the generated line and only work by last-wins.
# How much of one `state` workspace this platform will store, in bytes. Past it
# a write is refused with a message the model reads.
SANDBOX_STATE_MAX_BYTES=4194304
# Above this, an attached image is written to the workspace and not also sent
# inline. Below it the model gets both: it should see the picture, and it should
# be able to run something over the file.
SANDBOX_INLINE_IMAGE_MAX_BYTES=5242880
# Google Drive sync (service account)
GOOGLE_DRIVE_CREDENTIALS_FILE=credentials/google-drive-sa.json
# S3/MinIO sync
S3_RAG_ENDPOINT=
S3_RAG_ACCESS_KEY=
S3_RAG_SECRET_KEY=
S3_RAG_BUCKET=agenticos-rag
S3_RAG_REGION=us-east-1

# === Prefect ===
# Self-hosted (open-source): keep the default below.
# Prefect Cloud: set to your workspace URL and add PREFECT_API_KEY.
PREFECT_API_URL=http://localhost:4200/api
# PREFECT_API_KEY=pnu_xxxxxxxxxxxxxxxxxxxx   # required for Cloud only
# Flow runs executed at once; the rest queue. A memory ceiling, not a throughput
# dial - each run is a process importing the whole application, and the moment it
# matters is the restart after downtime, when a backlog is waiting.
PREFECT_RUNNER_LIMIT=5

# === Web search ===
# No key here on purpose: an agent chooses its own search method in the
# Builder (DuckDuckGo needs none; Tavily, Brave and Exa take a key stored in
# the organization's vault, so each tenant brings its own).

# === Messaging Channels ===
# Nothing to configure here: each bot is registered in the app with its token
# — and, for Slack, its app's signing secret and xapp- token — sealed in the
# vault. The Telegram webhook URL is built from PUBLIC_BASE_URL.

# === Email ===
EMAIL_FROM=noreply@agenticos.com
EMAIL_FROM_NAME=agenticos
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
# auto: the port picks the scheme (465 implicit TLS, otherwise STARTTLS).
# implicit | starttls: force one, for a server on a non-standard port.
SMTP_TLS_MODE=auto

# === CORS ===
# JSON list of allowed origins (default: localhost:3000, localhost:8080)
# Note: "*" is blocked in production - specify explicit origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# === Deploying to a server ===
# Read only by the compose files, not by the application - which is why they are
# here rather than in `app/core/config.py`. See docs/deploy.md.
#
# The two hostnames this deployment answers on. `SITE_DOMAIN` has to agree with
# PUBLIC_SITE_URL above, and `API_DOMAIN` with PUBLIC_API_URL: one routes the
# request and the other is inlined into the browser bundle, so a mismatch is a
# site that loads and then talks to the wrong host.
# SITE_DOMAIN=app.example.com
# API_DOMAIN=api.example.com

# Which reverse proxy this host was set up with: `traefik` or `nginx`. Read by
# `scripts/deploy.sh`, so a deploy uses the proxy the host actually has rather
# than the one the script was written against.
# PROXY=traefik

# Where the Traefik overlays put the containers, and how the certificate is
# issued. Defaults suit a Traefik started from `docker-compose-traefik.yml`;
# point them at an existing one by name if you already run it.
# TRAEFIK_NETWORK=traefik_webgateway
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERT_RESOLVER=letsencrypt
# ACME_EMAIL=ops@example.com

# The Docker networks the stack's two compose projects meet on - the frontend
# is a project of its own and joins the backend's network by name. Only a host
# running two AgenticOS stacks needs to set these apart; the defaults are what
# every deployment used before. Both projects read this file, so one value
# serves both.
# AGENTICOS_NETWORK=agenticos_backend          # dev server
# AGENTICOS_DATA_NETWORK=agenticos_data        # production, internal
# AGENTICOS_EDGE_NETWORK=agenticos_edge        # production, the proxy's side

# How many uvicorn workers the API runs. Each is a separate process that imports
# the application on its own - about 460 MiB - so this is the setting that
# decides what the API costs at rest. Four for a busy deployment, two for a team.
# Lower `app`'s memory limit with it: roughly 600M per worker.
# UVICORN_WORKERS=4

# Count a login attempt against the caller rather than against the proxy. On by
# default in a deployment written by `scripts/server-init.sh`, and it has to be
# behind a reverse proxy: without it every request carries the proxy's own
# address, so a handful of failed logins locks the whole deployment out. Only
# safe while nothing can reach the API past the proxy - see BIND_HOST below.
# RATE_LIMIT_TRUST_FORWARDED_FOR=true

# Publish the API and the site on something other than the loopback. Leave it
# alone unless the reverse proxy runs on a different machine: anything that can
# reach past the proxy chooses the address its login attempts are counted
# against. See RATE_LIMIT_TRUST_FORWARDED_FOR.
# BIND_HOST=0.0.0.0

# A deployed stack needs REDIS_PASSWORD - fill in the one under Redis above.
# It is defined once, and commented out, in both directions on purpose. This
# file is copied to backend/.env and `docker-compose.yml` feeds that to the app
# container, where the local redis has no `requirepass`: a live value makes
# every dev request fail with "Client sent AUTH, but no password is set". And
# the deployed compose files pass `--requirepass ${REDIS_PASSWORD:?…}`, so they
# refuse to start until somebody sets a real one rather than inheriting
# `change-me-in-production` from an example.
