# agenticos Environment Variables

# === Project ===
PROJECT_NAME=agenticos
DEBUG=true
DB_ECHO=false  # Set to true to log SQL queries
ENVIRONMENT=local
TIMEZONE=UTC  # IANA timezone: UTC, Europe/Warsaw, America/New_York
MODELS_CACHE_DIR=./models_cache

# === Logfire ===
# Get your token at https://logfire.pydantic.dev
LOGFIRE_TOKEN=
LOGFIRE_SERVICE_NAME=agenticos
LOGFIRE_ENVIRONMENT=development


# === PostgreSQL ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agenticos

# === JWT Auth ===
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# === Secret vault ===
# Master key for every credential stored at rest — provider keys, channel bot
# tokens, MCP credentials and organization secrets. Empty falls back to
# SECRET_KEY so a fresh checkout runs; set it explicitly in production so stored
# secrets survive a SECRET_KEY rotation. Generate with: openssl rand -hex 32
VAULT_MASTER_KEY=
# Whether a model profile may point at a private / loopback address. Turn this
# on for a self-hosted install running Ollama, vLLM or a LiteLLM proxy; leave it
# off on a shared deployment, where any member who can add a provider key could
# otherwise use the backend to reach the internal network.
ALLOW_INTERNAL_MODEL_ENDPOINTS=false

# === API Key Auth ===
API_KEY=change-me-in-production
API_KEY_HEADER=X-API-Key

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_DB=0

# === RAG Configuration ===
# How documents are parsed, chunked and described is NOT configured here — it is
# a per-collection setting stored on the knowledge base and edited on /kb, so
# two collections on the same deployment can read a scanned contract archive and
# a folder of Markdown notes differently. Parser, OCR, chunk size and overlap,
# chunking strategy and the image-description model all live there.
RAG_DEFAULT_COLLECTION=documents
RAG_TOP_K=10
RAG_HYBRID_SEARCH=false  # Enable BM25 + vector hybrid search
# Vector Database (pgvector) — uses existing PostgreSQL connection
# === Parser credentials and addresses (deployment-level on purpose) ===
# A key is billed to the operator, and an OCR address on the internal network is
# not something a tenant may choose.
LLAMAPARSE_API_KEY=
# LiteParse OCR -- empty url uses the bundled Tesseract;
# point at e.g. http://easyocr:8000 or http://paddleocr:8000 for HTTP OCR.
LITEPARSE_OCR_SERVER_URL=
# Image Description (LLM vision)
RAG_IMAGE_DESCRIPTION_MODEL=  # empty = use AI_MODEL
# Google Drive (service account)
GOOGLE_DRIVE_CREDENTIALS_FILE=credentials/google-drive-sa.json
# S3/MinIO (document ingestion)
S3_RAG_ENDPOINT=
S3_RAG_ACCESS_KEY=
S3_RAG_SECRET_KEY=
S3_RAG_BUCKET=agenticos-rag
S3_RAG_REGION=us-east-1

# === Prefect ===
# Self-hosted (open-source): keep the default below.
# Prefect Cloud: set to your workspace URL and add PREFECT_API_KEY.
PREFECT_API_URL=http://localhost:4200/api
# PREFECT_API_KEY=pnu_xxxxxxxxxxxxxxxxxxxx   # required for Cloud only


# === AI Agent (pydantic_ai, openrouter) ===
OPENROUTER_API_KEY=
AI_MODEL=anthropic/claude-opus-4-7
AI_TEMPERATURE=0.7
AI_THINKING_ENABLED=false
AI_THINKING_EFFORT=medium  # low, medium, high

# === Web search ===
# No key here on purpose: an agent chooses its own search method in the
# Builder (DuckDuckGo needs none; Tavily, Brave and Exa take a key stored in
# the organization's vault, so each tenant brings its own).

# === Code execution (Monty sandbox) ===
ENABLE_CODE_EXECUTION=true
CODE_EXECUTION_TIMEOUT_SECS=10
CODE_EXECUTION_MAX_ALLOCATIONS=50000000

# === MCP Client (Settings → Integrations) ===
# Deployment-managed MCP servers, always attached on top of each user's own
# connections. JSON list; leave empty to rely purely on per-user connections.
# "name" is a slug (lowercase letters, digits, hyphens) and becomes the prefix
# of that server's tool names, so it must not clash with a name your users can
# pick in the marketplace — a clash means their connection is dropped in favour
# of this one. Startup fails on a malformed or duplicated name.
# MCP_SERVERS=[{"name":"github-internal","url":"https://api.githubcopilot.com/mcp/","headers":{"Authorization":"Bearer ghp_..."},"allowed_tools":["search_issues"]}]
MCP_SERVERS=[]
# Per-server budget for the pre-flight ping; unreachable servers are skipped.
MCP_CONNECT_TIMEOUT_SECS=3
# Embeddings
# OpenAI Embeddings
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Chunking
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50

# Retrieval
RAG_DEFAULT_COLLECTION=documents
RAG_TOP_K=10

# Reranker

# PDF Parser
PDF_PARSER=pymupdf
CHAT_PDF_PARSER=pymupdf
LLAMAPARSE_API_KEY=

# Google Drive (optional, for document ingestion)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# === Messaging Channels ===
# Telegram: webhook base URL for production (e.g. https://api.yourdomain.com)
# Leave empty to use long-polling mode (recommended for development)
TELEGRAM_WEBHOOK_BASE_URL=
# Slack app credentials — from https://api.slack.com/apps
# Signing secret: Basic Information → App Credentials → Signing Secret
SLACK_SIGNING_SECRET=
# Bot token: OAuth & Permissions → Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=
# App-level token: Basic Information → App-Level Tokens (xapp-..., for Socket Mode dev)
SLACK_APP_TOKEN=

# === Email ===
EMAIL_FROM=noreply@agenticos.com
EMAIL_FROM_NAME=agenticos
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# === CORS ===
# JSON list of allowed origins (default: localhost:3000, localhost:8080)
# Note: "*" is blocked in production - specify explicit origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# === Docker Production (Traefik) ===
# Domain for production deployment
DOMAIN=example.com

# Let's Encrypt email for SSL certificates
ACME_EMAIL=admin@example.com

# Traefik dashboard auth (generate with: htpasswd -nb admin password)
# TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$...
# Redis password for production
REDIS_PASSWORD=change-me-in-production
