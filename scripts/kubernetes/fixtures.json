          },
          "spec": {
            "containers": [
              {
                "name": "model-fixture",
                "image": "python:3.15-slim@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928",
                "ports": [
                  {
                    "containerPort": 4010
                  }
                ],
                "env": [],
                "resources": {
                  "requests": {
                    "cpu": "50m",
