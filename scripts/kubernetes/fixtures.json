{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "agenticos-smoke-deps"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "agenticos-smoke",
        "labels": {
          "pod-security.kubernetes.io/enforce": "restricted",
          "pod-security.kubernetes.io/enforce-version": "latest"
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "postgres",
        "namespace": "agenticos-smoke-deps"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "fixture": "postgres"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "fixture": "postgres"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "postgres",
                "image": "pgvector/pgvector:pg16@sha256:0dd3149a06e4579a0d70d8fef9945636cd514005e7237deb27f9b67886f8dc4f",
                "ports": [
                  {
                    "containerPort": 5432
                  }
                ],
                "env": [
                  {
                    "name": "POSTGRES_DB",
                    "value": "agenticos"
                  },
                  {
                    "name": "POSTGRES_USER",
                    "value": "agenticos"
                  },
                  {
                    "name": "POSTGRES_PASSWORD",
                    "value": "smoke-password"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "memory": "512Mi"
                  }
                },
                "readinessProbe": {
                  "tcpSocket": {
                    "port": 5432
                  },
                  "periodSeconds": 2
                },
                "args": [
                  "postgres",
                  "-c",
                  "ssl=on",
                  "-c",
                  "ssl_cert_file=/tls/tls.crt",
                  "-c",
                  "ssl_key_file=/tls/tls.key"
                ],
                "volumeMounts": [
                  {
                    "name": "database-tls",
                    "mountPath": "/tls",
                    "readOnly": true
                  }
                ]
              }
            ],
            "securityContext": {
              "fsGroup": 999
            },
            "volumes": [
              {
                "name": "database-tls",
                "secret": {
                  "secretName": "postgres-tls",
                  "defaultMode": 288
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "postgres",
        "namespace": "agenticos-smoke-deps"
      },
      "spec": {
        "selector": {
          "fixture": "postgres"
        },
        "ports": [
          {
            "port": 5432
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "valkey",
        "namespace": "agenticos-smoke-deps"
      },
      "spec": {
        "replicas": 1,
