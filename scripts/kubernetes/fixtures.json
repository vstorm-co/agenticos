          },
          "spec": {
            "containers": [
              {
                "name": "minio",
                "image": "pgsty/minio:RELEASE.2026-08-04T00-00-00Z@sha256:b6bfe7239bfc83fb90d31612d9704d86039dd714f7904b3f1ad68f211e602372",
                "ports": [
                  {
                    "containerPort": 9000
                  }
                ],
                "env": [
                  {
                    "name": "MINIO_ROOT_USER",
                    "value": "smoke-access"
                  },
                  {
                    "name": "MINIO_ROOT_PASSWORD",
                    "value": "smoke-secret-password"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "memory": "512Mi"
                  }
                },
                "readinessProbe": {
                  "tcpSocket": {
                    "port": 9000
                  },
                  "periodSeconds": 2
                },
                "command": [
                  "minio",
                  "server",
                  "/data"
                ]
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "minio",
        "namespace": "agenticos-smoke-deps"
      },
      "spec": {
        "selector": {
          "fixture": "minio"
        },
        "ports": [
          {
            "port": 9000
          }
        ]
      }
    },
    {
