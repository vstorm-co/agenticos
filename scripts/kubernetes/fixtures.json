          },
          "spec": {
            "containers": [
              {
                "name": "valkey",
                "image": "valkey/valkey:8-alpine@sha256:2602ace2be6569bc2bbb06f873776516ab9089821525be34f4305c67eb9db02a",
                "ports": [
                  {
                    "containerPort": 6379
                  }
                ],
                "env": [],
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "memory": "512Mi"
                  }
                },
                "readinessProbe": {
                  "tcpSocket": {
                    "port": 6379
                  },
                  "periodSeconds": 2
                },
                "command": [
                  "valkey-server",
                  "--save",
                  ""
                ]
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "valkey",
        "namespace": "agenticos-smoke-deps"
      },
      "spec": {
        "selector": {
          "fixture": "valkey"
        },
        "ports": [
          {
            "port": 6379
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "minio",
        "namespace": "agenticos-smoke-deps"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
