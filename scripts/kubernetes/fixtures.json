                    "memory": "512Mi"
                  }
                },
                "readinessProbe": {
                  "tcpSocket": {
                    "port": 4010
                  },
                  "periodSeconds": 2
                },
                "command": [
                  "python",
                  "/fixture/server.py"
                ],
                "volumeMounts": [
                  {
                    "name": "fixture",
                    "mountPath": "/fixture",
                    "readOnly": true
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "fixture",
                "configMap": {
                  "name": "model-fixture"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "model-fixture",
        "namespace": "agenticos-smoke-deps"
      },
      "spec": {
        "selector": {
