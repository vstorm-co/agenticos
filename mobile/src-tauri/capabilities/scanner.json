{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "scanner",
  "description": "The camera, for the onboarding page's pairing-code scanner - and only there.",
  "windows": ["main"],
  "platforms": ["iOS", "android"],
  "permissions": ["barcode-scanner:allow-scan", "barcode-scanner:allow-cancel", "barcode-scanner:allow-check-permissions", "barcode-scanner:allow-request-permissions", "barcode-scanner:allow-open-app-settings"]
}
