    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To scan the pairing code your console shows, and to take a photo for a message."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby zeskanować kod parowania z konsoli i zrobić zdjęcie do wiadomości."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um den Kopplungscode deiner Konsole zu scannen und ein Foto für eine Nachricht aufzunehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para escanear el código de vinculación de tu consola y hacer una foto para un mensaje."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To unlock AgenticOS."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby odblokować AgenticOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um AgenticOS zu entsperren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para desbloquear AgenticOS."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To offer the photo you just took when you open a chat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby po otwarciu czatu zaproponować zdjęcie zrobione przed chwilą."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um beim Öffnen eines Chats das gerade aufgenommene Foto anzubieten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ofrecerte la foto que acabas de hacer al abrir un chat."
          }
        }
      }
    },
