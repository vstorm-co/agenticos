# Local eval only. Replace the placeholder before starting.
SANDBOXD_TOKEN=replace-with-a-random-local-token
SANDBOX_WORKSPACE_ROOT=/tmp/agenticos-personal-eval-workspaces
# Optional on Linux when the Docker socket belongs to a nonzero group.
DOCKER_GID=0
# Needed for Model replay, a judge or provider bootstrap. Keep it out of git.
OPENROUTER_API_KEY=
AGENTICOS_EVAL_MODEL=deepseek/deepseek-v4-flash-0731
AGENTICOS_EVAL_JUDGE_MODEL=openrouter:z-ai/glm-5.3
# Copy both IDs from the bootstrap database query in README.md.
AGENTICOS_EVAL_ORG_ID=
AGENTICOS_EVAL_USER_ID=
# Keep app DB credentials separate from an existing development stack.
POSTGRES_DB=agenticos_personal_eval
POSTGRES_PASSWORD=local-eval-only
